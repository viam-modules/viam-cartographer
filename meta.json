{
  "module_id": "viam:cartographer",
  "visibility": "public",
  "url": "https://github.com/viam-modules/viam-cartographer",
  "description": "Go module for Google Cartographer",
  "models": [
    {
      "api": "rdk:service:slam",
      "model": "viam:slam:cartographer"
    }
  ],
  "entrypoint": "cartographer-module.AppImage",
  "build": {
    "setup": "make setup",
    "build": "make appimage && cp etc/packaging/appimages/deploy/cartographer-module-*.AppImage cartographer-module.AppImage && tar czf module.tar.gz cartographer-module.AppImage",
    "path": "module.tar.gz",
    "arch": ["linux/amd64", "linux/arm64"]
  }
}